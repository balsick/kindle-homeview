// Copy this file to "home_config.h" and put in your own home's data.
// home_config.h is kept out of git, like arduino_secrets.h.

// Location for the weather (Open-Meteo)
const float LATITUDE = 45.4642;
const float LONGITUDE = 9.1900;

// Lights for the webapp: same channels and names as config.sh on the Kindle
const char* const SHELLY_HOST = "192.168.1.50";  // Shelly IP (reserve it in your router)
const Light LIGHTS[] = {{"Soggiorno", 0}, {"Cucina", 1}, {"Studio", 2}};

// Spotify: music only counts if it plays on a device of this type
// (Echos are "Speaker"; a phone is "Smartphone", a Mac "Computer").
const char* const SPOTIFY_HOME_TYPE = "Speaker";
// Where the Back key starts music when nothing is playing at home
const char* const SPOTIFY_HOME_DEVICE = "Soggiorno";
// Fallback playlist when there's nothing to resume ("" = none),
// e.g. "spotify:playlist:37i9dQZF1DXcBWIGoYBM5M"
const char* const SPOTIFY_FALLBACK_CONTEXT = "";

