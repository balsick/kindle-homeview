// Copy this file to "arduino_secrets.h" and fill in the values.
// Don't share arduino_secrets.h: it holds your Spotify secrets.
// WiFi doesn't go here: Arduino Cloud configures it (Network Configurator).
// In the Cloud Editor these values show up in the "Secret" tab.

// From the Spotify developer dashboard (see README) and tools/get_spotify_token.py.
// Leave SECRET_SPOTIFY_REFRESH_TOKEN empty to disable Spotify.
#define SECRET_SPOTIFY_CLIENT_ID ""
#define SECRET_SPOTIFY_CLIENT_SECRET ""
#define SECRET_SPOTIFY_REFRESH_TOKEN ""

// GitHub token for the Kindle's OTA updates, only needed if the repository
// in OTA_GITHUB_REPO (home_config.h) is private: a fine-grained token limited
// to that repository, with "Contents: read-only" permission (see README).
#define SECRET_GITHUB_TOKEN ""
