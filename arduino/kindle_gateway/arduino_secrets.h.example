// Copia questo file in "arduino_secrets.h" e compila i valori.
// arduino_secrets.h non va condiviso: contiene i segreti di Spotify.
// Il WiFi non serve qui: lo configura Arduino Cloud (Network Configurator).
// Nel Cloud Editor questi valori compaiono nella scheda "Secret".

// Dal developer dashboard di Spotify (vedi README) e da tools/get_spotify_token.py.
// Lascia SECRET_SPOTIFY_REFRESH_TOKEN vuoto per disattivare Spotify.
#define SECRET_SPOTIFY_CLIENT_ID ""
#define SECRET_SPOTIFY_CLIENT_SECRET ""
#define SECRET_SPOTIFY_REFRESH_TOKEN ""

// Token GitHub per gli aggiornamenti OTA del Kindle: fine-grained token
// limitato al repository, permesso "Contents: read-only" (vedi README).
// Lascialo vuoto per disattivare l'OTA.
#define SECRET_GITHUB_TOKEN ""
